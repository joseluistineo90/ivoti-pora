<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delicadezas Ivotí Porá - Pan y Dulces Artesanales | Formosa Argentina</title>
    <meta name="description" content="Panadería artesanal en Formosa. Budines, pan dulce, helados caseros y más. Delivery gratis 1-6 PM. Pedidos por WhatsApp.">
    
    <!-- Schema.org markup para Google -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Bakery",
      "name": "Delicadezas Ivotí Porá",
      "description": "Panadería artesanal especializada en pan y dulces caseros",
      "url": "https://delicadezasivotipora.com",
      "telephone": "+54-3716-42-3700",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Petrona Martínez 190",
        "addressLocality": "Pozo del Tigre",
        "addressRegion": "Formosa",
        "addressCountry": "AR"
      },
      "openingHours": [
        "Mo-Su 13:00-18:00"
      ],
      "priceRange": "$",
      "servesCuisine": "Panadería Argentina",
      "paymentAccepted": "Efectivo, Transferencia bancaria"
    }
    </script>

    <style>
        /* --- VARIABLES Y RESET --- */
        :root {
            --primary: #D6407C;
            --primary-light: #F8BBD9;
            --primary-dark: #B8326A;
            --accent: #E67E22;
            --accent-light: #FAD7A0;
            --leaf: #90C695;
            --pistil: #FFD700;
            --bg-body: #FFF5F9;
            --card-bg: #FFFFFF;
            --text-main: #333333;
            --text-light: #666666;
            --shadow: 0 10px 20px rgba(214, 64, 124, 0.15);
            --shadow-light: 0 5px 15px rgba(214, 64, 124, 0.1);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            padding-bottom: 80px;
            line-height: 1.6;
        }

        /* --- MEJORAS DE ACCESIBILIDAD --- */
        button:focus-visible,
        input:focus-visible,
        textarea:focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 2px;
        }

        .btn-add:focus-visible,
        .btn-whatsapp:focus-visible {
            outline: 3px solid #FFFFFF;
            outline-offset: 2px;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* --- HEADER STICKY --- */
        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-icon-container {
            position: relative;
            cursor: pointer;
            padding: 5px;
            transition: transform 0.2s;
            border: none;
            background: none;
        }

        .cart-icon-container:active { transform: scale(0.9); }

        .cart-svg {
            width: 32px;
            height: 32px;
            fill: var(--text-main);
        }

        .cart-count {
            position: absolute;
            top: -2px;
            right: -5px;
            background-color: var(--primary);
            color: white;
            font-size: 0.75rem;
            font-weight: bold;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s;
        }

        .cart-count.visible { opacity: 1; }
        .cart-count.bump { transform: scale(1.5); }

        /* --- HERO SECTION MEJORADA --- */
        .hero {
            position: relative;
            min-height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: linear-gradient(135deg, rgba(255, 245, 249, 0.9) 0%, rgba(255, 232, 245, 0.8) 100%);
        }

        .hero-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .hero-background::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, rgba(214, 64, 124, 0.1) 0%, rgba(230, 126, 34, 0.1) 100%);
            z-index: 2;
        }

        .hero-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            filter: brightness(0.6) contrast(1.1);
        }

        .hero-content {
            position: relative;
            z-index: 3;
            text-align: center;
            color: var(--text-main);
            padding: 40px 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 15px;
            color: var(--primary);
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }
        
        /* --- MEJORAS DE CONTRASTE HERO --- */
        .hero h2 {
            color: white !important;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.7);
            font-weight: 600;
            font-size: 2rem;
            margin-bottom: 20px;
        }

        .hero p {
            color: rgba(255,255,255,0.95) !important;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
            font-weight: 500;
            font-size: 1.2rem;
            margin-bottom: 30px;
        }

        /* --- ELEMENTOS FLORALES DECORATIVOS --- */
        .floral-accent {
            position: absolute;
            width: 40px;
            height: 40px;
            opacity: 0.1;
            background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
            border-radius: 50%;
            z-index: 2;
        }

        .hero::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(214, 64, 124, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(230, 126, 34, 0.05) 0%, transparent 50%);
            z-index: 2;
        }

        @keyframes petal-fall {
            0% { transform: translateY(-10px) rotate(0deg); opacity: 0; }
            50% { opacity: 0.7; }
            100% { transform: translateY(100px) rotate(360deg); opacity: 0; }
        }

        .floral-particle {
            position: absolute;
            width: 8px;
            height: 8px;
            background: var(--primary-light);
            border-radius: 50%;
            animation: petal-fall 8s linear infinite;
            z-index: 2;
        }

        .info-banner {
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
            color: white;
            padding: 20px;
            border-radius: 15px;
            margin: 30px auto;
            max-width: 600px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(10px);
            position: relative;
            z-index: 3;
        }

        .info-banner h3 {
            margin-bottom: 10px;
            font-size: 1.4rem;
        }

        .info-banner p {
            color: white;
            margin-bottom: 8px;
            font-size: 1.1rem;
            text-shadow: none;
        }

        @media (max-width: 768px) {
            .hero {
                min-height: 60vh;
            }
            
            .hero h1 { 
                font-size: 2.2rem;
                margin-bottom: 10px;
            }
            
            .hero h2 { 
                font-size: 1.6rem;
                margin-bottom: 15px;
            }
            
            .hero p { 
                font-size: 1.1rem;
                margin-bottom: 20px;
            }
            
            .info-banner {
                padding: 15px;
                margin: 20px auto;
            }
            
            .info-banner h3 {
                font-size: 1.2rem;
            }
            
            .info-banner p {
                font-size: 1rem;
            }
        }

        @media (max-width: 480px) {
            .hero {
                min-height: 50vh;
            }
            
            .hero h1 { 
                font-size: 1.8rem;
            }
            
            .hero h2 { 
                font-size: 1.4rem;
            }
            
            .hero p { 
                font-size: 1rem;
            }
        }

        /* --- CONTAINER --- */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* --- FILTROS DE CATEGORÍAS --- */
        .category-filters {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin: 30px 0;
        }

        .category-btn {
            background: white;
            border: 2px solid var(--primary-light);
            color: var(--primary);
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .category-btn:hover {
            background: var(--primary-light);
            transform: translateY(-2px);
        }

        .category-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* --- PRODUCTS GRID --- */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); /* Ancho mínimo aumentado */
            gap: 30px; /* Espacio aumentado */
            margin-bottom: 50px;
        }

        @media (min-width: 768px) {
            .products-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (min-width: 1024px) {
            .products-grid { grid-template-columns: repeat(3, 1fr); }
        }

        /* --- TARJETA DE PRODUCTO REAJUSTADA --- */
        .product-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 20px; /* Reducido para dar más espacio a la imagen */
            text-align: center;
            box-shadow: var(--shadow-light);
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.5);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%; /* Para que todas las tarjetas tengan la misma altura */
        }

        .product-card:hover { 
            transform: translateY(-8px);
            box-shadow: var(--shadow);
        }

        .product-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--primary-light);
            color: var(--primary);
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            z-index: 2;
        }

        /* --- CONTENEDOR DE IMAGEN REAJUSTADO PARA IMÁGENES VERTICALES --- */
        .img-container {
            width: 100%;
            height: 320px; /* Altura aumentada para vertical */
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 15px;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #f9f9f9 0%, #f0f0f0 100%);
            position: relative;
            flex-shrink: 0; /* Evita que se encoja */
        }
        
        /* IMÁGENES VERTICALES - SIN RECORTE */
        .img-container img {
            width: auto;
            max-width: 100%;
            height: auto;
            max-height: 100%;
            object-fit: contain; /* Muestra toda la imagen sin recortar */
            object-position: center;
            transition: transform 0.5s ease;
            border-radius: 10px;
        }

        .img-container .img-error {
            width: 60px;
            height: 60px;
            opacity: 0.3;
        }
        
        .product-card:hover .img-container img {
            transform: scale(1.05);
        }

        /* CONTENIDO DE LA TARJETA - MEJOR DISTRIBUCIÓN */
        .card-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .p-title {
            font-weight: bold;
            margin: 10px 0 5px;
            font-size: 1.2rem;
            color: var(--text-main);
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .p-description {
            color: var(--text-light);
            font-size: 0.9rem;
            margin-bottom: 10px;
            line-height: 1.4;
            min-height: 40px;
            flex: 1;
        }
        
        .p-price {
            color: var(--primary);
            font-weight: 800;
            font-size: 1.3rem;
            margin-bottom: 15px;
        }

        /* --- SELECTOR DE CANTIDADES --- */
        .quantity-selector {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .quantity-btn {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            border: 2px solid var(--primary);
            background: white;
            color: var(--primary);
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .quantity-btn:hover {
            background: var(--primary);
            color: white;
        }

        .quantity-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .quantity-btn:disabled:hover {
            background: white;
            color: var(--primary);
        }

        .quantity-display {
            font-weight: bold;
            font-size: 1.1rem;
            min-width: 30px;
            text-align: center;
        }

        .btn-add {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 12px 0;
            width: 100%;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            position: relative;
            overflow: hidden;
            margin-top: auto; /* Empuja el botón hacia abajo */
        }

        .btn-add:hover { background-color: var(--primary-dark); }

        .btn-add.loading {
            color: transparent;
        }

        .btn-add.loading::after {
            content: "";
            position: absolute;
            width: 20px;
            height: 20px;
            top: 50%;
            left: 50%;
            margin-left: -10px;
            margin-top: -10px;
            border: 2px solid #ffffff;
            border-radius: 50%;
            border-top-color: transparent;
            animation: spin 0.8s ease infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* --- RESPONSIVE PARA IMÁGENES --- */
        @media (max-width: 768px) {
            .img-container {
                height: 280px; /* Altura reducida para móviles */
            }
            
            .products-grid {
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 20px;
            }
        }

        @media (max-width: 480px) {
            .img-container {
                height: 250px; /* Altura aún más reducida para móviles pequeños */
            }
            
            .product-card {
                padding: 15px;
            }
        }

        /* --- SECCIÓN "LA FLOR DETRÁS DE LOS SABORES" --- */
        .about-flor {
            background: white;
            border-radius: 25px;
            padding: 50px 30px;
            margin: 60px 0;
            box-shadow: var(--shadow-light);
        }

        .about-flor h3 {
            text-align: center;
            color: var(--primary);
            font-size: 2rem;
            margin-bottom: 30px;
        }

        .flor-story {
            display: flex;
            align-items: center;
            gap: 30px;
            max-width: 800px;
            margin: 0 auto;
        }

        .flor-story img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid var(--primary-light);
            box-shadow: var(--shadow);
        }

        .story-text {
            flex: 1;
        }

        .story-text p {
            margin-bottom: 15px;
            font-size: 1.1rem;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .flor-story {
                flex-direction: column;
                text-align: center;
            }
            
            .flor-story img {
                width: 120px;
                height: 120px;
            }
        }

        /* --- ORDER SECTION --- */
        .order-section {
            background: white;
            border-radius: 25px;
            padding: 30px;
            box-shadow: 0 -5px 30px rgba(0,0,0,0.05);
            margin-top: 40px;
            scroll-margin-top: 100px;
        }

        .cart-list {
            list-style: none;
            margin-bottom: 20px;
            border-bottom: 2px dashed #eee;
            padding-bottom: 20px;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f9f9f9;
        }

        .btn-remove {
            background: #ffebee;
            color: #d32f2f;
            border: none;
            width: 25px;
            height: 25px;
            border-radius: 50%;
            cursor: pointer;
            font-weight: bold;
            margin-left: 10px;
            transition: background 0.2s;
        }

        .btn-remove:hover {
            background: #ffcdd2;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 30px;
        }

        /* --- DELIVERY OPTIONS --- */
        .delivery-options {
            margin: 20px 0;
            padding: 15px;
            background: #f9f9f9;
            border-radius: 12px;
        }

        .delivery-options label {
            display: flex;
            align-items: center;
            padding: 10px;
            cursor: pointer;
            transition: background 0.2s;
            border-radius: 8px;
        }

        .delivery-options label:hover {
            background: rgba(214, 64, 124, 0.05);
        }

        .delivery-options input[type="radio"] {
            width: auto;
            margin-right: 10px;
            cursor: pointer;
        }

        /* --- FORM --- */
        .form-grid {
            display: grid;
            gap: 15px;
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
        }
        
        input, textarea {
            width: 100%;
            padding: 15px;
            border: 2px solid #eee;
            border-radius: 12px;
            font-size: 1rem;
            transition: border 0.3s;
            font-family: inherit;
            background: white;
        }
        
        input:focus, textarea:focus {
            outline: none;
            border-color: var(--primary);
        }

        input::placeholder {
            color: #999;
            opacity: 1;
        }

        input.error {
            border-color: #ff4444;
            animation: shake 0.3s;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .input-error-msg {
            color: #ff4444;
            font-size: 0.85rem;
            margin-top: 5px;
            margin-bottom: 5px;
            display: none;
        }

        .input-error-msg.show {
            display: block;
        }

        .btn-whatsapp {
            background-color: #25D366;
            color: white;
            border: none;
            padding: 18px;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s;
            position: relative;
            overflow: hidden;
        }
        
        .btn-whatsapp:hover {
            transform: scale(1.02);
            background-color: #20bd5a;
        }

        .btn-whatsapp.loading {
            color: transparent;
        }

        .btn-whatsapp.loading::after {
            content: "";
            position: absolute;
            width: 20px;
            height: 20px;
            top: 50%;
            left: 50%;
            margin-left: -10px;
            margin-top: -10px;
            border: 2px solid #ffffff;
            border-radius: 50%;
            border-top-color: transparent;
            animation: spin 0.8s ease infinite;
        }

        /* --- TOAST NOTIFICATION --- */
        .toast {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #4CAF50;
            color: white;
            padding: 15px 30px;
            border-radius: 50px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
            font-weight: 600;
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            z-index: 2000;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .toast.warning {
            background: #ff9800;
        }

        .toast.error {
            background: #f44336;
        }

        @media (max-width: 600px) {
            .toast {
                bottom: 90px;
                left: 20px;
                right: 20px;
                transform: translateX(0) translateY(100px);
            }
            .toast.show {
                transform: translateX(0) translateY(0);
            }
        }

        /* --- BOTÓN FLOTANTE WHATSAPP --- */
        .float-btn-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 5000;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            text-decoration: none;
            border: none;
            background: none;
        }

        .float-btn-container:hover {
            transform: scale(1.1);
        }

        .float-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 3px solid #ffffff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            overflow: hidden;
            background-color: #fff;
            position: relative;
        }

        .float-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
        }

        /* --- EFECTO DE PARPADEO PARA EL STATUS DOT --- */
.status-dot {
    position: absolute;
    bottom: 5px;
    right: 5px;
    width: 15px;
    height: 15px;
    background-color: #25D366;
    border: 2px solid white;
    border-radius: 50%;
    z-index: 5001;
    animation: pulse-green 2s infinite;
}

@keyframes pulse-green {
    0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
    }
    50% {
        transform: scale(1.1);
        box-shadow: 0 0 0 5px rgba(37, 211, 102, 0);
    }
    100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
}

/* Efecto más sutil para cuando está en hover */
.float-btn-container:hover .status-dot {
    animation: none;
    transform: scale(1.2);
    transition: transform 0.3s ease;
}
/* Efecto de latido del corazón */
@keyframes heartbeat {
    0% {
        transform: scale(1);
    }
    25% {
        transform: scale(1.1);
    }
    50% {
        transform: scale(1);
    }
    75% {
        transform: scale(1.1);
    }
    100% {
        transform: scale(1);
    }
}

.status-dot.alternative {
    animation: heartbeat 2s infinite;
}

        /* --- GLOBO DE TEXTO --- */
        .chat-bubble {
            position: absolute;
            right: 85px;
            top: 50%;
            transform: translateY(-50%);
            background: #ffffff;
            color: #333333;
            padding: 8px 16px;
            border-radius: 20px 20px 0 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            font-size: 0.9rem;
            font-weight: 600;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s, transform 0.3s;
        }

        /* Triangulito del globo */
        .chat-bubble::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: -8px;
            width: 0;
            height: 0;
            border-style: solid;
            border-width: 10px 0 0 10px;
            border-color: transparent transparent transparent #ffffff;
        }

        /* Mostrar globo en hover (PC) */
        .float-btn-container:hover .chat-bubble {
            opacity: 1;
            transform: translateY(-50%) translateX(0);
        }

        /* Mostrar globo en tap (móvil) */
        .float-btn-container.active .chat-bubble {
            opacity: 1;
            transform: translateY(-50%) translateX(0);
        }

        /* Responsive */
        @media (max-width: 480px) {
            .float-btn-container {
                bottom: 20px;
                right: 20px;
            }
            .float-avatar {
                width: 60px;
                height: 60px;
            }
            .chat-bubble {
                font-size: 0.8rem;
                padding: 6px 12px;
                right: 75px;
            }
        }

        /* --- FOOTER --- */
        footer {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-light);
            margin-top: 60px;
            background: white;
            border-radius: 25px 25px 0 0;
        }

        footer p {
            margin-bottom: 10px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        .social-links a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: transform 0.2s;
        }

        .social-links a:hover {
            transform: scale(1.1);
        }
        
        /* --- INDICADOR DE LOCALSTORAGE --- */
        .storage-indicator {
            position: fixed;
            top: 10px;
            right: 10px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 0.8rem;
            z-index: 10000;
            display: none;
        }
        
        .storage-indicator.show {
            display: block;
            animation: fadeOut 2s forwards;
        }
        
        @keyframes fadeOut {
            0% { opacity: 1; }
            70% { opacity: 1; }
            100% { opacity: 0; }
        }
        
        /* --- CONFIRMACIÓN DE ELIMINACIÓN --- */
        .confirmation-dialog {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 3000;
            align-items: center;
            justify-content: center;
        }
        
        .confirmation-content {
            background: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            max-width: 400px;
            width: 90%;
        }
        
        .confirmation-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
        }
        
        .confirmation-buttons button {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }
        
        .btn-confirm {
            background: #d32f2f;
            color: white;
        }
        
        .btn-cancel {
            background: #757575;
            color: white;
        }

        /* --- CONFIRMACIÓN DE ENVÍO WHATSAPP --- */
        .whatsapp-confirmation-dialog {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 3000;
            align-items: center;
            justify-content: center;
        }
        
        .whatsapp-confirmation-content {
            background: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            max-width: 500px;
            width: 90%;
        }
        
        .whatsapp-confirmation-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
        }
        
        .whatsapp-confirmation-buttons button {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
        }
        
        .btn-whatsapp-confirm {
            background: #25D366;
            color: white;
        }
        
        .btn-whatsapp-cancel {
            background: #757575;
            color: white;
        }

        /* --- LOADING OVERLAY --- */
        .loading-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.9);
            z-index: 4000;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }

        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid var(--primary-light);
            border-top: 5px solid var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        .loading-text {
            font-size: 1.2rem;
            color: var(--primary);
            font-weight: 600;
        }
    </style>
</head>
<body>

    <!-- INDICADOR DE LOCALSTORAGE -->
    <div id="storage-indicator" class="storage-indicator"></div>

    <!-- LOADING OVERLAY -->
    <div id="loading-overlay" class="loading-overlay">
        <div class="loading-spinner"></div>
        <div class="loading-text">Procesando...</div>
    </div>

    <!-- CONFIRMACIÓN DE ELIMINACIÓN -->
    <div id="confirmation-dialog" class="confirmation-dialog">
        <div class="confirmation-content">
            <h3>¿Eliminar producto?</h3>
            <p>¿Estás seguro de que quieres eliminar este producto del carrito?</p>
            <div class="confirmation-buttons">
                <button id="btn-cancel" class="btn-cancel">Cancelar</button>
                <button id="btn-confirm" class="btn-confirm">Eliminar</button>
            </div>
        </div>
    </div>

    <!-- CONFIRMACIÓN DE ENVÍO WHATSAPP -->
    <div id="whatsapp-confirmation-dialog" class="whatsapp-confirmation-dialog">
        <div class="whatsapp-confirmation-content">
            <h3>¿Enviar pedido por WhatsApp?</h3>
            <p>Se abrirá WhatsApp para que envíes tu pedido. ¿Estás seguro de que quieres continuar?</p>
            <div class="whatsapp-confirmation-buttons">
                <button id="btn-whatsapp-cancel" class="btn-whatsapp-cancel">Cancelar</button>
                <button id="btn-whatsapp-confirm" class="btn-whatsapp-confirm">Enviar Pedido</button>
            </div>
        </div>
    </div>

    <!-- HEADER STICKY -->
    <header>
        <a href="#" class="brand">
            <svg width="40" height="40" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-labelledby="logo-title">
                <title id="logo-title">Logo Delicadezas Ivotí Porá - Flor artesanal</title>
                <!-- Pétalos como hojas de masa o dulce -->
                <path d="M50,20 Q60,15 65,25 Q70,35 60,40 Q50,45 40,40 Q30,35 35,25 Q40,15 50,20" 
                      fill="#D6407C" opacity="0.8"/>
                
                <!-- Centro del budín/pan -->
                <circle cx="50" cy="30" r="8" fill="#E67E22"/>
                
                <!-- Detalles de textura -->
                <circle cx="47" cy="28" r="2" fill="#FFD700"/>
                <circle cx="53" cy="28" r="2" fill="#FFD700"/>
                
                <!-- Tallo elegante -->
                <path d="M50,48 Q45,60 40,70 Q35,80 45,85" 
                      stroke="#90C695" stroke-width="4" fill="none"/>
            </svg>
            <div style="display: flex; flex-direction: column; align-items: flex-start;">
                <span style="font-size: 1.3rem; line-height: 1;">Delicadezas</span>
                <span style="font-size: 1rem; font-weight: 600; color: var(--accent);">Ivotí Porá</span>
            </div>
        </a>

        <button class="cart-icon-container" onclick="scrollToCart()" aria-label="Ver carrito de compras">
            <svg class="cart-svg" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
            </svg>
            <span id="cart-count" class="cart-count" aria-live="polite">0</span>
        </button>
    </header>

    <!-- HERO SECTION MEJORADA -->
    <section class="hero" aria-labelledby="hero-title">
        <!-- Partículas florales decorativas -->
        <div class="floral-particle" style="left: 10%; animation-delay: 0s;"></div>
        <div class="floral-particle" style="left: 20%; animation-delay: 1s;"></div>
        <div class="floral-particle" style="left: 30%; animation-delay: 2s;"></div>
        <div class="floral-particle" style="left: 40%; animation-delay: 3s;"></div>
        <div class="floral-particle" style="left: 50%; animation-delay: 4s;"></div>
        <div class="floral-particle" style="left: 60%; animation-delay: 5s;"></div>
        <div class="floral-particle" style="left: 70%; animation-delay: 6s;"></div>
        <div class="floral-particle" style="left: 80%; animation-delay: 7s;"></div>
        <div class="floral-particle" style="left: 90%; animation-delay: 8s;"></div>
        
        <div class="hero-background">
            <img src="images/panaderia.jpg" alt="Familia disfrutando de productos artesanales - panes, budines y helados caseros" class="hero-image" onerror="this.style.display='none'">
        </div>
        <div class="hero-content">
            <h1 id="hero-title">Delicadezas Ivotí Porá</h1>
            <h2>Donde cada producto es una flor de sabor</h2>
            <p>Como Flor, te ofrezco lo mejor de mi arte en panificados. Productos que florecen con amor para endulzar tus momentos especiales.</p>
            
            <div class="info-banner" role="complementary">
                <h3>Horario de Entrega</h3>
                <p><strong>1:00 PM - 22:00 PM</strong> | Delivery gratis o retiro personal</p>
                <p><strong>Métodos de pago:</strong> Efectivo o transferencia bancaria</p>
            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container">
        
        <!-- FILTROS DE CATEGORÍAS -->
        <div class="category-filters" id="category-filters">
            <button class="category-btn active" data-category="all">Todos los Productos</button>
            <button class="category-btn" data-category="panes">Panes Artesanales</button>
            <button class="category-btn" data-category="dulces">Dulces Tradicionales</button>
            <button class="category-btn" data-category="helados">Helados Caseros</button>
        </div>
        
        <!-- GRILLA DE PRODUCTOS -->
        <section aria-labelledby="products-title">
            <h2 id="products-title" class="sr-only">Nuestros Productos Artesanales</h2>
            <div class="products-grid" id="products-container"></div>
        </section>

        <!-- SECCIÓN "LA FLOR DETRÁS DE LOS SABORES" -->
        <section class="about-flor">
            <h3>La Flor detrás de los sabores</h3>
            <div class="flor-story">
                <img src="./images/florencia.jpg" alt="Flor - Fundadora de Delicadezas Ivotí Porá" onerror="this.src='data:image/svg+xml;base64,'">
                <div class="story-text">
                    <p>"Soy Flor, y así como mi nombre, quise crear algo grato y dulce para mi comunidad. Ivotí Porá significa 'Flor Bonita' en Guaraní, y eso es lo que quiero que sientas con cada bocado: la belleza simple de lo hecho con amor."</p>
                    <p>Con más de 5 años de experiencia en panadería artesanal, cada producto lleva un pedacito de mi corazón y tradición familiar.</p>
                </div>
            </div>
        </section>

        <!-- SECCION PEDIDO -->
        <section class="order-section" id="carrito-section" aria-labelledby="cart-title">
            <h3 id="cart-title">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: middle; margin-right: 8px;">
                    <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                </svg>
                Tu Pedido
            </h3>
            
            <ul class="cart-list" id="cart-list" aria-live="polite">
                <li style="text-align: center; color: #999; padding: 20px;">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity: 0.3; margin-bottom: 10px;" aria-hidden="true">
                        <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                    </svg>
                    <div>Tu carrito está vacío</div>
                </li>
            </ul>

            <div class="total-row">
                <span>Total</span>
                <span>$<span id="total-price">0</span></span>
            </div>

            <h4>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: middle; margin-right: 5px; color: var(--primary);">
                    <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                </svg>
                Método de Entrega
            </h4>
            <div class="delivery-options">
                <label>
                    <input type="radio" name="delivery" value="domicilio" checked aria-describedby="delivery-domicilio">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: middle; margin-right: 5px; color: var(--primary);">
                        <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                    </svg>
                    <span>Entrega a Domicilio</span>
                    <span id="delivery-domicilio" class="sr-only">Delivery gratis de 1:00 PM a 6:00 PM</span>
                </label>
                <label>
                    <input type="radio" name="delivery" value="retiro" aria-describedby="delivery-retiro">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: middle; margin-right: 5px; color: var(--primary);">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    <span>Retiro Personal</span>
                    <span id="delivery-retiro" class="sr-only">Retiro en Petrona Martínez 190, Pozo del Tigre, Formosa</span>
                </label>
            </div>

            <h4>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: middle; margin-right: 5px; color: var(--primary);">
                    <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                </svg>
                Datos de Contacto
            </h4>
            <div class="form-grid">
                <div class="form-group">
                    <label for="cliente" class="sr-only">Tu Nombre</label>
                    <input type="text" id="cliente" placeholder="Tu Nombre *" required aria-required="true">
                </div>
                <div class="form-group">
                    <label for="telefono" class="sr-only">Teléfono</label>
                    <input type="tel" id="telefono" placeholder="Teléfono: 11 1234-5678 o 3716 42-3700 *" required maxlength="15" aria-required="true" aria-describedby="telefono-error">
                    <div id="telefono-error" class="input-error-msg" role="alert">Por favor ingresa un número de teléfono argentino válido</div>
                </div>
                <div class="form-group">
                    <label for="direccion" class="sr-only">Dirección de entrega</label>
                    <input type="text" id="direccion" placeholder="Dirección de entrega (si aplica)" aria-describedby="direccion-help">
                    <div id="direccion-help" class="sr-only">Solo necesario si seleccionaste entrega a domicilio</div>
                </div>
                <div class="form-group">
                    <label for="notas" class="sr-only">Notas adicionales</label>
                    <textarea id="notas" rows="2" placeholder="Notas adicionales (opcional)"></textarea>
                </div>
            </div>

            <button class="btn-whatsapp" onclick="confirmarEnvioWhatsApp()" aria-label="Enviar pedido por WhatsApp">
                <svg width="24" height="24" fill="white" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.008-.57-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Enviar Pedido por WhatsApp
            </button>
        </section>

    </main>

    <!-- FOOTER -->
    <footer role="contentinfo">
        <svg width="60" height="60" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-labelledby="footer-logo">
            <title id="footer-logo">Logo Delicadezas Ivotí Porá</title>
            <!-- Pétalos como hojas de masa o dulce -->
            <path d="M50,20 Q60,15 65,25 Q70,35 60,40 Q50,45 40,40 Q30,35 35,25 Q40,15 50,20" 
                  fill="#D6407C" opacity="0.8"/>
            
            <!-- Centro del budín/pan -->
            <circle cx="50" cy="30" r="8" fill="#E67E22"/>
            
            <!-- Detalles de textura -->
            <circle cx="47" cy="28" r="2" fill="#FFD700"/>
            <circle cx="53" cy="28" r="2" fill="#FFD700"/>
            
            <!-- Tallo elegante -->
            <path d="M50,48 Q45,60 40,70 Q35,80 45,85" 
                  stroke="#90C695" stroke-width="4" fill="none"/>
        </svg>
        <p><strong>Delicadezas Ivotí Porá</strong> - Pan y Dulces Artesanales</p>
        <p style="font-style: italic; color: var(--primary);">"Flor Bonita" en Guaraní</p>
        <p>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: middle; margin-right: 5px;">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Petrona Martínez 190, Pozo del Tigre, Formosa | 
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: middle; margin: 0 5px;">
                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
            </svg>
            WhatsApp: +54 9 3716 42-3700
        </p>
        <p><strong>Horario:</strong> 12:00 PM - 22:00 PM | <strong>Delivery gratis</strong> o retiro personal</p>
        <div class="social-links">
            <a href="https://www.instagram.com/florezco_dondesea?igsh=ZHBrY2toaHEzejQx" target="_blank" aria-label="Síguenos en Instagram">Instagram</a>
            <a href="https://www.facebook.com/gasparini.flor" target="_blank" aria-label="Síguenos en Facebook">Facebook</a>
            <a href="https://wa.me/5493716423700" target="_blank" aria-label="Escríbenos por WhatsApp">WhatsApp</a>
        </div>
        <p style="margin-top: 20px; font-size: 0.9rem; color: #999;">
            © 2026 Delicadezas Ivotí Porá. Panadería artesanal Formosa. Todos los derechos reservados.
        </p>
        <p style="margin-top: 10px; font-size: 0.9rem; color: #999;">
            <strong>Desarrollado por Caracas Digital Design. José Luis Tineo. Caracas-Venezuela.</strong>
        </p>
    </footer>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="toast" role="alert" aria-live="polite">
        <span>✓</span>
        <span id="toast-message">Producto agregado al carrito</span>
    </div>

    <!-- BOTÓN FLOTANTE WHATSAPP -->
    <button class="float-btn-container" id="floatBtn" onclick="handleFloatClick(event)" aria-label="Chatear por WhatsApp con atención al cliente">
        <div class="chat-bubble">¡Hola! ¿Te ayudo?</div>
        <div class="float-avatar">
            <img src="./images/flor.jpg" alt="Atención al cliente de Delicadezas Ivotí Porá" onerror="this.src='data:image/svg+xml;base64,'">
            <div class="status-dot"></div>
        </div>
    </button>

    <script>
        // --- CONFIGURACIÓN ---
        const telefonoWhatsApp = "5493716423700"; 

        // --- DATOS MEJORADOS CON CATEGORÍAS Y DESCRIPCIONES ---
        const productos = [
            { 
                id: 1, 
                nombre: "Budines Artesanales", 
                precio: 2500, 
                imagen: "./images/budin.jpg", 
                alt: "Budines artesanales recién horneados",
                categoria: "dulces",
                descripcion: "Esponjosos budines caseros con esencia de vainilla y ralladura de limón, horneados a la perfección."
            },
            { 
                id: 2, 
                nombre: "Pan Dulce Tradicional", 
                precio: 4000, 
                imagen: "./images/pan_dulce.jpg", 
                alt: "Pan dulce tradicional argentino",
                categoria: "dulces",
                descripcion: "Nuestro clásico pan dulce con frutas abrillantadas, nueces, chispas de chocolate y un toque secreto de especias."
            },
            { 
                id: 3, 
                nombre: "Pan Casero con Jamón y Queso", 
                precio: 2000, 
                imagen: "./images/pan_de_queso.jpg", 
                alt: "Pan casero relleno de jamón y queso",
                categoria: "panes",
                descripcion: "Pan artesanal relleno generosamente con jamón cocido y queso mantecoso derretido."
            },
            { 
                id: 4, 
                nombre: "Pan Casero Tradicional", 
                precio: 1000, 
                imagen: "./images/pan_casero.jpg", 
                alt: "Pan casero tradicional sin relleno",
                categoria: "panes",
                descripcion: "Pan de masa madre con fermentación lenta, corteza crujiente y miga esponjosa."
            },
            { 
                id: 5, 
                nombre: "Tortas de grasa al Horno", 
                precio: 1000, 
                imagen: "./images/tortas.jpg", 
                alt: "Tortas artesanales horneadas",
                categoria: "dulces",
                descripcion: "Deliciosas tortas de Grasa caseras, perfectas para la merienda."
            },
            { 
                id: 6, 
                nombre: "Helados Cremosos", 
                precio: 400, 
                imagen: "./images/palitos_de_crema.jpg", 
                alt: "Helados caseros cremosos",
                categoria: "helados",
                descripcion: "Helado artesanal extra cremoso en sabores clásicos como vainilla, chocolate y dulce de leche."
            },
            { 
                id: 7, 
                nombre: "Helados de Agua (4 unidades)", 
                precio: 1000, 
                imagen: "./images/palitos_de_agua.jpg", 
                alt: "Helados de agua refrescantes",
                categoria: "helados",
                descripcion: "Trio de helados de agua refrescantes en sabores frutales como limón, frutilla, naranja y otros."
            },
            { 
                id: 8, 
                nombre: "Pizzas Congeladas (unidad)", 
                precio: 9000, 
                imagen: "./images/pizza.jpg",  // Producto congelado para saber si tiene receptividad
                alt: "Pizzas congeladas listas para microondas",
                categoria: "helados",
                descripcion: "Pizzas Congeladas, perfecta para micro ondas. Si su tiempo es limitado es la opción perfecta "
            },
            { 
                id: 9, 
                nombre: "Bombón Helado (unidad)", 
                precio: 500, 
                imagen: "./images/palitos_de_bombon.jpg", 
                alt: "Bombones helados gourmet",
                categoria: "helados",
                descripcion: "Exquisito bombón helado con centro suave y cobertura de chocolate semi-amargo."
            }
        ];

        let carrito = [];
        let itemToRemove = null;
        let categoriaActiva = 'all';

        // --- FUNCIONES DE LOCALSTORAGE ---
        function guardarCarrito() {
            try {
                localStorage.setItem('delicadezasCarrito', JSON.stringify(carrito));
                console.log('Carrito guardado:', carrito);
            } catch (e) {
                console.error('Error guardando carrito:', e);
            }
        }

        function cargarCarrito() {
            try {
                const carritoGuardado = localStorage.getItem('delicadezasCarrito');
                if (carritoGuardado) {
                    carrito = JSON.parse(carritoGuardado);
                    console.log('Carrito cargado:', carrito);
                    return true;
                }
            } catch (e) {
                console.error('Error cargando carrito:', e);
            }
            return false;
        }

        function limpiarTodo() {
            carrito = [];
            localStorage.removeItem('delicadezasCarrito');
            
            // LIMPIAR FORMULARIO - CORRECIÓN IMPORTANTE
            document.getElementById('cliente').value = '';
            document.getElementById('telefono').value = '';
            document.getElementById('direccion').value = '';
            document.getElementById('notas').value = '';
            
            actualizarUI();
        }

        // --- MANEJO DE ERRORES EN IMÁGENES ---
        function manejarErrorImagen(imagen) {
            imagen.style.display = 'none';
            const container = imagen.parentElement;
            const svgError = `
                <svg class="img-error" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21 5v14H3V5h18m0-2H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-8 10.5h-2v2h2v-2zm0-4h-2v2h2v-2zm0-4h-2v2h2v-2z"/>
                </svg>
            `;
            container.innerHTML += svgError;
        }

        // --- RENDERIZAR PRODUCTOS CON CATEGORÍAS ---
        function renderizarProductos(categoria = 'all') {
            const container = document.getElementById('products-container');
            container.innerHTML = '';
            
            const productosFiltrados = categoria === 'all' 
                ? productos 
                : productos.filter(prod => prod.categoria === categoria);
            
            productosFiltrados.forEach(prod => {
                const card = document.createElement('div');
                card.className = 'product-card';
                card.innerHTML = `
                    <!--   <div class="product-badge">
                     <span class="floral-tag">🌸 Hecho por Flor</span>
                    </div>-->
                    <div class="img-container">
                        <img src="${prod.imagen}" alt="${prod.alt}" loading="lazy" onerror="manejarErrorImagen(this)">
                    </div>
                    <div class="card-content">
                        <div class="p-title">${prod.nombre}</div>
                        <div class="p-description">${prod.descripcion}</div>
                        <div class="p-price">$${prod.precio}</div>
                        <div class="quantity-selector">
                            <button class="quantity-btn" onclick="decreaseQuantity(${prod.id})" aria-label="Reducir cantidad">-</button>
                            <span class="quantity-display" id="quantity-${prod.id}">1</span>
                            <button class="quantity-btn" onclick="increaseQuantity(${prod.id})" aria-label="Aumentar cantidad">+</button>
                        </div>
                        <button class="btn-add" onclick="agregar(${prod.id})" aria-label="Agregar ${prod.nombre} al carrito">AGREGAR</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // --- FILTROS DE CATEGORÍAS ---
        function configurarFiltros() {
            const botones = document.querySelectorAll('.category-btn');
            botones.forEach(boton => {
                boton.addEventListener('click', function() {
                    // Remover clase active de todos los botones
                    botones.forEach(btn => btn.classList.remove('active'));
                    // Agregar clase active al botón clickeado
                    this.classList.add('active');
                    // Actualizar categoría activa y renderizar productos
                    categoriaActiva = this.dataset.category;
                    renderizarProductos(categoriaActiva);
                });
            });
        }

        // --- SELECTOR DE CANTIDADES ---
        function increaseQuantity(productId) {
            const quantityDisplay = document.getElementById(`quantity-${productId}`);
            let quantity = parseInt(quantityDisplay.textContent) || 1;
            quantityDisplay.textContent = quantity + 1;
        }

        function decreaseQuantity(productId) {
            const quantityDisplay = document.getElementById(`quantity-${productId}`);
            let quantity = parseInt(quantityDisplay.textContent) || 1;
            if (quantity > 1) {
                quantityDisplay.textContent = quantity - 1;
            }
        }

        function getQuantity(productId) {
            const quantityDisplay = document.getElementById(`quantity-${productId}`);
            return parseInt(quantityDisplay.textContent) || 1;
        }

        function resetQuantity(productId) {
            const quantityDisplay = document.getElementById(`quantity-${productId}`);
            quantityDisplay.textContent = '1';
        }

        // --- LOADING STATES ---
        function mostrarLoading() {
            document.getElementById('loading-overlay').style.display = 'flex';
        }

        function ocultarLoading() {
            document.getElementById('loading-overlay').style.display = 'none';
        }

        function setButtonLoading(button, isLoading) {
            if (isLoading) {
                button.classList.add('loading');
                button.disabled = true;
            } else {
                button.classList.remove('loading');
                button.disabled = false;
            }
        }

        // --- LÓGICA DEL CARRITO ---
        function agregar(id) {
            const prod = productos.find(p => p.id === id);
            const quantity = getQuantity(id);
            const boton = event.target;
            
            // Mostrar loading state
            setButtonLoading(boton, true);
            
            // Simular procesamiento asíncrono
            setTimeout(() => {
                for (let i = 0; i < quantity; i++) {
                    carrito.push(prod);
                }
                
                guardarCarrito();
                actualizarUI();
                animarContador();
                mostrarToast(`${quantity} ${prod.nombre} agregado${quantity > 1 ? 's' : ''} al carrito`, false);
                resetQuantity(id);
                
                // Quitar loading state
                setButtonLoading(boton, false);
            }, 600);
        }

        function mostrarToast(mensaje, esAdvertencia = false, esError = false) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            toastMessage.textContent = mensaje;
            
            toast.classList.remove('warning', 'error');
            if (esAdvertencia) {
                toast.classList.add('warning');
            } else if (esError) {
                toast.classList.add('error');
            }
            
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        function solicitarEliminacion(index) {
            itemToRemove = index;
            document.getElementById('confirmation-dialog').style.display = 'flex';
        }

        function eliminar() {
            if (itemToRemove !== null) {
                carrito.splice(itemToRemove, 1);
                guardarCarrito();
                actualizarUI();
                itemToRemove = null;
            }
            document.getElementById('confirmation-dialog').style.display = 'none';
        }

        function cancelarEliminacion() {
            itemToRemove = null;
            document.getElementById('confirmation-dialog').style.display = 'none';
        }

        function actualizarUI() {
            const countBadge = document.getElementById('cart-count');
            countBadge.innerText = carrito.length;
            
            if (carrito.length > 0) {
                countBadge.classList.add('visible');
            } else {
                countBadge.classList.remove('visible');
            }

            const list = document.getElementById('cart-list');
            const totalSpan = document.getElementById('total-price');
            list.innerHTML = '';
            
            let total = 0;

            if (carrito.length === 0) {
                list.innerHTML = `
                    <li style="text-align: center; color: #999; padding: 20px;">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity: 0.3; margin-bottom: 10px;" aria-hidden="true">
                            <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                        </svg>
                        <div>Tu carrito está vacío</div>
                    </li>
                `;
            } else {
                // Agrupar productos iguales
                const productosAgrupados = {};
                carrito.forEach(item => {
                    if (!productosAgrupados[item.id]) {
                        productosAgrupados[item.id] = {
                            producto: item,
                            cantidad: 1
                        };
                    } else {
                        productosAgrupados[item.id].cantidad++;
                    }
                });

                Object.values(productosAgrupados).forEach((grupo, index) => {
                    const subtotal = grupo.producto.precio * grupo.cantidad;
                    total += subtotal;
                    
                    const li = document.createElement('li');
                    li.className = 'cart-item';
                    li.innerHTML = `
                        <div>
                            <img src="${grupo.producto.imagen}" alt="${grupo.producto.alt}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 8px; margin-right: 10px; vertical-align: middle;" onerror="this.style.display='none'">
                            ${grupo.producto.nombre} ${grupo.cantidad > 1 ? `(${grupo.cantidad})` : ''}
                        </div>
                        <div style="display:flex; align-items:center;">
                            <strong>$${subtotal}</strong>
                            <button class="btn-remove" onclick="solicitarEliminacion(${index})" aria-label="Eliminar ${grupo.producto.nombre} del carrito">✕</button>
                        </div>
                    `;
                    list.appendChild(li);
                });
            }
            totalSpan.innerText = total;
        }

        function animarContador() {
            const badge = document.getElementById('cart-count');
            badge.classList.remove('bump');
            void badge.offsetWidth;
            badge.classList.add('bump');
        }

        function scrollToCart() {
            document.getElementById('carrito-section').scrollIntoView({ behavior: 'smooth' });
        }

        // --- GENERAR NÚMERO DE ORDEN ---
        function generarNumeroOrden() {
            const hoy = new Date();
            const fecha = hoy.toISOString().split('T')[0].replace(/-/g, '');
            
            let pedidosHoy = JSON.parse(localStorage.getItem('pedidosDelDia') || '{"fecha": "", "contador": 0}');
            
            if (pedidosHoy.fecha !== fecha) {
                pedidosHoy = { fecha: fecha, contador: 0 };
            }
            
            pedidosHoy.contador++;
            localStorage.setItem('pedidosDelDia', JSON.stringify(pedidosHoy));
            
            return `IP-${fecha}-${String(pedidosHoy.contador).padStart(4, '0')}`;
        }

        // --- VALIDACIÓN MEJORADA DE TELÉFONO ---
        function validarTelefonoArgentino(telefono) {
            // Limpiar el número
            const numeroLimpio = telefono.replace(/\s/g, '').replace(/-/g, '');
            
            // Patrones para números argentinos
            const patrones = [
                /^(?:(?:00)?549?)?0?(?:11|[2368]\d)(?:(?=\d{0,2}15)\d{2})??\d{8}$/, // Celulares
                /^(?:(?:00)?549?)?0?(?:11|[2368]\d)\d{8}$/, // Celulares alternativo
                /^[1-9]\d{9}$/ // Teléfonos fijos (10 dígitos)
            ];
            
            return patrones.some(patron => patron.test(numeroLimpio));
        }

        // --- CONFIRMACIÓN DE ENVÍO WHATSAPP ---
        function confirmarEnvioWhatsApp() {
            if (carrito.length === 0) {
                mostrarToast("¡El carrito está vacío! Agrega productos primero", true);
                return;
            }
            
            document.getElementById('whatsapp-confirmation-dialog').style.display = 'flex';
        }

        function cancelarEnvioWhatsApp() {
            document.getElementById('whatsapp-confirmation-dialog').style.display = 'none';
        }

        // --- ENVIAR WHATSAPP ---
        function enviarPedido() {
            // Ocultar diálogo de confirmación
            document.getElementById('whatsapp-confirmation-dialog').style.display = 'none';
            
            // Mostrar loading
            mostrarLoading();
            const botonWhatsApp = document.querySelector('.btn-whatsapp');
            setButtonLoading(botonWhatsApp, true);
            
            // Simular procesamiento
            setTimeout(() => {
                const numeroOrden = generarNumeroOrden();
                
                const cliente = document.getElementById('cliente').value.trim();
                const telefono = document.getElementById('telefono').value.trim();
                const direccion = document.getElementById('direccion').value.trim();
                const notas = document.getElementById('notas').value.trim();
                const deliveryMethod = document.querySelector('input[name="delivery"]:checked').value;

                // Validaciones mejoradas
                if (!cliente) {
                    mostrarToast("Por favor completa tu nombre", true);
                    document.getElementById('cliente').focus();
                    ocultarLoading();
                    setButtonLoading(botonWhatsApp, false);
                    return;
                }
                
                if (!telefono) {
                    mostrarToast("Por favor completa tu teléfono", true);
                    document.getElementById('telefono').focus();
                    ocultarLoading();
                    setButtonLoading(botonWhatsApp, false);
                    return;
                }
                
                if (!validarTelefonoArgentino(telefono)) {
                    mostrarToast("Por favor ingresa un número de teléfono argentino válido", true);
                    document.getElementById('telefono-error').classList.add('show');
                    document.getElementById('telefono').classList.add('error');
                    document.getElementById('telefono').focus();
                    ocultarLoading();
                    setButtonLoading(botonWhatsApp, false);
                    return;
                }
                
                if (deliveryMethod === 'domicilio' && !direccion) {
                    mostrarToast("Por favor completa la dirección de entrega", true);
                    document.getElementById('direccion').focus();
                    ocultarLoading();
                    setButtonLoading(botonWhatsApp, false);
                    return;
                }

                let msg = `PEDIDO #${numeroOrden} - DELICADEZAS IVOTI PORA\n\n`;
                msg += `Hola! Soy ${cliente}\n`;
                msg += `Telefono: ${telefono}\n\n`;
                
                if (deliveryMethod === 'domicilio') {
                    msg += `ENTREGA A DOMICILIO\n`;
                    msg += `Direccion: ${direccion}\n\n`;
                } else {
                    msg += `RETIRO PERSONAL\n`;
                    msg += `Direccion: Petrona Martinez 190, Pozo del Tigre\n\n`;
                }
                
                msg += `MI PEDIDO:\n`;
                msg += `---------------------------\n`;
                
                let total = 0;
                const productosAgrupados = {};
                
                // Agrupar productos
                carrito.forEach(item => {
                    if (!productosAgrupados[item.id]) {
                        productosAgrupados[item.id] = {
                            producto: item,
                            cantidad: 1
                        };
                    } else {
                        productosAgrupados[item.id].cantidad++;
                    }
                });

                // Formatear mensaje
                Object.values(productosAgrupados).forEach(grupo => {
                    const subtotal = grupo.producto.precio * grupo.cantidad;
                    total += subtotal;
                    msg += `- ${grupo.producto.nombre}`;
                    if (grupo.cantidad > 1) {
                        msg += ` (x${grupo.cantidad})`;
                    }
                    msg += ` - $${subtotal}\n`;
                });

                msg += `---------------------------\n`;
                msg += `TOTAL: $${total}\n\n`;
                
                msg += `Horario de entrega: 1:00 PM - 6:00 PM\n`;
                msg += `Metodos de pago: Efectivo o transferencia\n`;
                
                if(notas) {
                    msg += `\nNotas adicionales: ${notas}\n`;
                }

                // CORRECCIÓN: Limpiar TODO después de enviar (carrito + formulario)
                limpiarTodo();
                
                // Ocultar loading
                ocultarLoading();
                setButtonLoading(botonWhatsApp, false);
                
                window.open(`https://wa.me/${telefonoWhatsApp}?text=${encodeURIComponent(msg)}`, '_blank');
            }, 1500);
        }

        // --- MANEJO DEL BOTÓN FLOTANTE MEJORADO ---
        function handleFloatClick(event) {
            event.preventDefault();
            
            // Si el carrito está vacío, mostrar mensaje y hacer scroll a productos
            if (carrito.length === 0) {
                mostrarToast("Hola! Agrega un producto para ayudarte", true);
                // Hacer scroll suave a la sección de productos
                document.querySelector('.products-grid').scrollIntoView({ 
                    behavior: 'smooth',
                    block: 'start'
                });
            } else {
                // Si hay productos, abrir WhatsApp con mensaje de consulta
                const msg = "Hola! Vengo desde la tienda online y tengo productos en el carrito. Me gustaria hacer un pedido.";
                window.open(`https://wa.me/${telefonoWhatsApp}?text=${encodeURIComponent(msg)}`, '_blank');
            }
        }

        // --- INICIALIZACIÓN ---
        document.addEventListener('DOMContentLoaded', function() {
            const floatBtn = document.getElementById('floatBtn');
            let tapTimeout;
            
            // Configuración de eventos de confirmación
            document.getElementById('btn-confirm').addEventListener('click', eliminar);
            document.getElementById('btn-cancel').addEventListener('click', cancelarEliminacion);
            document.getElementById('btn-whatsapp-confirm').addEventListener('click', enviarPedido);
            document.getElementById('btn-whatsapp-cancel').addEventListener('click', cancelarEnvioWhatsApp);
            
            // Configurar filtros de categorías
            configurarFiltros();
            
            // Renderizar productos iniciales
            renderizarProductos();
            
            // Para dispositivos táctiles
            if ('ontouchstart' in window) {
                floatBtn.addEventListener('touchstart', function(e) {
                    // Agregar clase active para mostrar el globo
                    this.classList.add('active');
                    
                    // Limpiar timeout previo si existe
                    if (tapTimeout) clearTimeout(tapTimeout);
                    
                    // Quitar la clase después de 3 segundos
                    tapTimeout = setTimeout(() => {
                        this.classList.remove('active');
                    }, 3000);
                });
            }
            
            // Cargar carrito al iniciar la página
            if (cargarCarrito()) {
                actualizarUI();
            }
        });

        // --- FORMATEAR TELÉFONO MIENTRAS ESCRIBE ---
        document.getElementById('telefono').addEventListener('input', function(e) {
            let value = e.target.value.replace(/[^\d\s\-]/g, '');
            e.target.value = value;
            
            const errorMsg = document.getElementById('telefono-error');
            errorMsg.classList.remove('show');
            e.target.classList.remove('error');
        });

        // --- CAMBIO EN MÉTODO DE ENTREGA ---
        document.querySelectorAll('input[name="delivery"]').forEach(radio => {
            radio.addEventListener('change', function() {
                const direccionInput = document.getElementById('direccion');
                if (this.value === 'domicilio') {
                    direccionInput.required = true;
                    direccionInput.placeholder = "Dirección de entrega *";
                } else {
                    direccionInput.required = false;
                    direccionInput.placeholder = "Dirección (opcional para entrega)";
                }
            });
        });

        // --- NAVEGACIÓN POR TECLADO MEJORADA ---
        document.addEventListener('keydown', function(e) {
            // Escape cierra los diálogos de confirmación
            if (e.key === 'Escape') {
                if (document.getElementById('confirmation-dialog').style.display === 'flex') {
                    cancelarEliminacion();
                }
                if (document.getElementById('whatsapp-confirmation-dialog').style.display === 'flex') {
                    cancelarEnvioWhatsApp();
                }
            }
        });
    </script>
</body>
</html>